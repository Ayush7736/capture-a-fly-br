{
  "version": 2,
  "functions": {
    "api/npc.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/game/:path*",
      "destination": "https://capture-a-fly.onrender.com/game/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://capture-a-fly.onrender.com/api/:path*"
    },
    {
      "source": "/manifest.webmanifest",
      "destination": "https://capture-a-fly.onrender.com/manifest.webmanifest"
    },
    {
      "source": "/",
      "destination": "/frontend/index.html"
    }
  ],
  "headers": [
    {
      "source": "/game/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
